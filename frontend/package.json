{
  "name": "kalpavriksha-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next dev",
    "build": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src",
    "vercel-build": "tsx scripts/db-migrate.ts && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:seed-dev": "tsx scripts/seed-dev.ts",
    "content:import": "tsx scripts/import-videos.ts",
    "textbook:upload": "tsx scripts/upload-textbook.ts",
    "textbook:upload-folder": "tsx scripts/upload-textbooks-folder.ts",
    "storage:check": "tsx scripts/storage-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@electric-sql/pglite": "^0.5.17",
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders": "^0.0.82",
    "@paper-design/shaders-react": "^0.0.82",
    "@phosphor-icons/react": "^2.1.10",
    "@types/three": "^0.186.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "html2canvas-pro": "^2.6.0",
    "lenis": "^1.3.26",
    "motion": "^14.5.0",
    "next": "^16.3.8",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
