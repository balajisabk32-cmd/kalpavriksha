# Copy to .env.local for local development. Nothing here is required locally:
# without DATABASE_URL the app uses an embedded database in .data/pglite.

# Postgres (Neon). Use the pooled connection string. Set in Vercel → Settings → Environment Variables.
DATABASE_URL=

# Secret Vercel sends to /api/cron/promote (the daily class-promotion job). Any long random string.
CRON_SECRET=
